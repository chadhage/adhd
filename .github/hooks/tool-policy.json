{
  "version": 1,
  "hooks": {
    "preToolUse": [
      {
        "type": "command",
        "command": "node .github/hooks/pre-tool-policy.mjs preToolUse",
        "timeoutSec": 5
      }
    ],
    "postToolUse": [
      {
        "type": "command",
        "command": "node .github/hooks/pre-tool-policy.mjs postToolUse",
        "timeoutSec": 5
      }
    ],
    "subagentStart": [
      {
        "type": "command",
        "command": "node .github/hooks/pre-tool-policy.mjs subagentStart",
        "timeoutSec": 5
      }
    ]
  }
}